# GuardianAI Environment Variables

# Groq API Key & Model Configuration for CrewAI (llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Google Gemini API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MQTT Broker Configuration
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883

# Hardware Sensor Thresholds
SMOKE_THRESHOLD_PPM=350.0
TEMP_THRESHOLD_CELSIUS=45.0
VIBRATION_THRESHOLD_G=2.5
